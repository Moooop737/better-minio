# 网关监听。同机还有 MinIO 两个端口：S3 9000 / Console 9001（非 S3，管理 UI）——别撞。
GATEWAY_PORT=9100
GATEWAY_HOST=127.0.0.1

# 网关 → MinIO 的真连接。
#   生产（2c2g 同机）：http://127.0.0.1:9000
#   开发连远程 MinIO：填 MinIO 的 tailnet / 公网 endpoint
S3_INTERNAL_ENDPOINT=http://127.0.0.1:9000

# presign 签进 URL 的 Host（浏览器可见入口；Caddy 反代必须保持 Host，否则 403）。
#   生产：https://<IP>:9000（Caddy TLS 反代）或 IP:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000

S3_REGION=us-east-1
S3_BUCKET=kbfile
S3_FORCE_PATH_STYLE=true

# 密钥只进进程，不打印、不进错误信息
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=