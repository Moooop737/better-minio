# 网关监听。同机还有 MinIO 两个端口：S3 9000 / Console 9001（非 S3，管理 UI）——别撞。
GATEWAY_PORT=9100
GATEWAY_HOST=127.0.0.1

# 网关 → MinIO 的真连接。
#   生产（2c2g 同机）：http://127.0.0.1:9000
#   开发连远程 MinIO：填 MinIO 的 tailnet / 公网 endpoint
S3_INTERNAL_ENDPOINT=http://127.0.0.1:9000

# presign 签进 URL 的 Host = 网关公开入口（浏览器可见；Caddy 只做 TLS 终止且必须保持 Host，否则 403）。
#   生产：https://files.example.com（Caddy → 网关 :9100）
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9100

S3_REGION=us-east-1
S3_BUCKET=kbfile
S3_FORCE_PATH_STYLE=true

# 密钥只进进程，不打印、不进错误信息
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── auth ──
# JWT（HS256）密钥，≥32 字符，只在网关
TOKEN_SECRET=
# 服务间凭证：name:token 逗号列表；token 字符集 [A-Za-z0-9_-]{32,}；name 即审计身份
SERVICE_TOKENS=backend:replace-with-32+-chars-random-token-xxxx
# 可信反代（IP/CIDR 逗号列表）；空 = 谁都不信，直接用 TCP peer
TRUSTED_PROXIES=
# OCI push 白名单（其余认证服务只 pull）
OCI_PUSH_SERVICES=d1

# ── 功能开关（严格 true/false，非法拒启）──
MULTIPART_ENABLED=true
OCI_ENABLED=false
IP_GATE_ENABLED=true
RATE_LIMIT_ENABLED=true
AUDIT_ENABLED=true
THUMBNAIL_ENABLED=false
# flat | date（date = put / multipart create 加 YYYY/MM/ 前缀，响应恒回实际 key）
KEY_SCHEME=flat
# 数据面 CORS 白名单（逗号列表）；空 = 不开 CORS
CORS_ORIGINS=

# 可选 Redis：给了就持久化瞬态状态（会话 / 限流 / 缩略图队列），连不上拒启；不给 = 全内存（重启丢）
# REDIS_URL=redis://127.0.0.1:6379

# ── multipart ──
MULTIPART_SESSION_TTL=86400

# ── oci ──
S3_REGISTRY_BUCKET=kcregistry
OCI_UPLOAD_TTL=3600

# ── ops ──
LOG_LEVEL=info
RATE_LIMIT_CONTROL=60
RATE_LIMIT_DATA=300
RATE_LIMIT_OCI=120
# 优雅关闭 drain 上限（秒）；compose stop_grace_period 需更大（35s）
SHUTDOWN_TIMEOUT=30

# ── thumbnail（THUMBNAIL_ENABLED=true 时生效）──
THUMBNAIL_WIDTH=300
THUMBNAIL_FORMAT=webp
THUMBNAIL_QUALITY=80
